{
  "name": "dsh-mimo-voice",
  "version": "0.2.0",
  "description": "Xiaomi MiMo TTS voice plugin for DeepSeek Harness: speak a chosen line through the local speakers, with API key / voice design / preview controls in settings.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "tts",
    "mimo",
    "xiaomi",
    "voice"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dddmxza/dsh-mimo-voice.git"
  },
  "homepage": "https://github.com/dddmxza/dsh-mimo-voice#readme",
  "bugs": {
    "url": "https://github.com/dddmxza/dsh-mimo-voice/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0"
  }
}
